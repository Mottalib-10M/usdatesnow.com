---
/**
 * Renders one tool with its page defaults: `countdown` (props: event, year, lock), `holidays`
 * (props: cal, year), `open` (props: focus, date), `workdays` (props: to) or `mini:<spec>` from `lib/mini-specs.ts`.
 */
import Countdown from './calc/Countdown';
import HolidayTable from './calc/HolidayTable';
import OpenToday from './calc/OpenToday';
import BusinessDays from './calc/BusinessDays';
import MiniSim from './calc/MiniSim';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { getSpec } from '../lib/mini-specs';
import type { ToolDef } from '../lib/guide-types';
interface Props { tool: ToolDef; lang?: Locale; primary?: boolean; idPrefix?: string; seedKey?: string }
const { tool, lang = 'en', primary = false, idPrefix } = Astro.props;
const props = (tool.props ?? {}) as Record<string, any>;
const kind = tool.kind;
const mini = kind.startsWith('mini:') ? kind.slice(5) : null;
const spec = mini ? getSpec(mini) : null;
const href = spec?.ctaPage && hasRoute(spec.ctaPage, lang) ? route(spec.ctaPage, lang) : undefined;
const numDefaults: Record<string, number> = {};
for (const [k, v] of Object.entries(props)) if (typeof v === 'number') numDefaults[k] = v;
---
{kind === 'countdown' && <Countdown client:load idPrefix={idPrefix ?? (primary ? 'cd' : 'cd2')} event={props.event ?? 'christmas'} year={props.year} lock={props.lock ?? false} primary={primary} />}
{kind === 'holidays' && <HolidayTable client:load idPrefix={idPrefix ?? (primary ? 'ht' : 'ht2')} cal={props.cal ?? 'federal'} year={props.year ?? 2027} primary={primary} />}
{kind === 'open' && <OpenToday client:load idPrefix={idPrefix ?? (primary ? 'op' : 'op2')} focus={props.focus ?? 'post'} date={props.date} primary={primary} />}
{kind === 'workdays' && <BusinessDays client:load idPrefix={idPrefix ?? (primary ? 'bd' : 'bd2')} to={props.to} primary={primary} />}
{mini && <MiniSim client:load kind={mini} href={href} defaults={numDefaults} primary={primary} idPrefix={idPrefix ?? (primary ? 'p' : 'm')} />}
