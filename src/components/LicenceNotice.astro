---
/** Attributions (RECETTE §12.1). Shown at the foot of every page, embeds included. */
interface Props { class?: string }
const { class: cls = 'text-xs text-navy-500' } = Astro.props;
---
<p class={cls} data-licence-notice>
  Holiday rules quoted from the United States Code and from OPM and Federal Reserve pages, which are works of the US government in the public domain. Exchange and Postal Service calendars are cited as facts, with a link to the page they were read on; no logo or page layout is reproduced.
  Countdowns, explanations and tools written by Radif Partners.
</p>
