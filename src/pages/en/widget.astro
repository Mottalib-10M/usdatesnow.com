---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/holiday-countdown/" title="US holiday countdown" width="100%" height="640" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/is-it-open-today/" title="Is it open today? Post office, banks, stock market" width="100%" height="620" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed a free US holiday countdown on your website" description="Put the live holiday countdown or the post office, bank and stock market closures checker on your website: one iframe, no sign-up, no tracking, no cookie and no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a countdown or the closures checker</h1>
    <p class="mt-3 text-lg text-navy-700">For schools, libraries, newsrooms, community groups and small businesses that post holiday hours.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Holiday countdown</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Is it open today?</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When an organization changes its calendar, the embedded tool follows. Nothing your visitors type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/holiday-countdown/" title="US holiday countdown" width="100%" height="640" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
